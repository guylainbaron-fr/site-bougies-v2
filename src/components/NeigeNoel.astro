<canvas id="neige-noel" aria-hidden="true"></canvas>

<style>
  #neige-noel {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
  }
</style>

<script>
  (function () {
    // --- CONFIGURATION DES DATES (calée sur la holiday bar : 20 nov -> 31 déc) ---
    // Format : (année, mois - 1, jour) -> Novembre = 10, Décembre = 11
    const DEBUT = new Date(2026, 10, 20); // 20 novembre 2026
    const FIN = new Date(2026, 11, 31, 23, 59, 59); // 31 décembre 2026 inclus

    const maintenant = new Date();
    if (maintenant < DEBUT || maintenant > FIN) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const canvas = document.getElementById('neige-noel');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = (canvas.width = window.innerWidth);
    let h = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    });

    const nbFlocons = w < 768 ? 45 : 80;
    const flocons = Array.from({ length: nbFlocons }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() * 3.3 + 1.5,
      d: Math.random() * 0.65 + 0.3,
      a: Math.random() * Math.PI * 2
    }));

    function animer() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
      ctx.shadowColor = 'rgba(120, 140, 160, 0.35)';
      ctx.shadowBlur = 3;
      ctx.beginPath();

      for (const f of flocons) {
        f.y += f.d;
        f.a += 0.01;
        f.x += Math.sin(f.a) * 0.4;

        if (f.y > h) {
          f.y = -5;
          f.x = Math.random() * w;
        }
        if (f.x > w) f.x = 0;
        if (f.x < 0) f.x = w;

        ctx.moveTo(f.x, f.y);
        ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
      }

      ctx.fill();
      requestAnimationFrame(animer);
    }

    animer();
  })();
</script>