---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
const pageId = "index";

import { Image } from 'astro:assets';

// Imports des composants
import DuelOuverture from '../components/DuelOuverture.astro';
// Imports d'images
import heroHome from "../assets/images/hero-home.webp";
import accueilImg from "../assets/images/accueil-h2-1.webp";
import imgCollection from '../assets/images/bougies-champignons-lozere-collection.webp';
import tableau3d from "../assets/images/tableau-3d.webp";
import atelierImg from "../assets/images/accueil-h2-2.webp";
import aproposImg from "../assets/images/accueil-h2-3.webp";

// --- DONNÉES STRUCTURÉES ---
const schemaData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://jf-aniuta.vercel.app/#organization",
      "name": "Jean-François & Aniuta",
      "url": "https://jf-aniuta.vercel.app/",
      "logo": {
        "@type": "ImageObject",
        "@id": "https://jf-aniuta.vercel.app/#logo",
        "url": "https://jf-aniuta.vercel.app/images/logo_512.png",
        "contentUrl": "https://jf-aniuta.vercel.app/images/logo_512.png",
        "width": 512,
        "height": 512,
        "caption": "Jean-François & Aniuta"
      },
      "image": { "@id": "https://jf-aniuta.vercel.app/#logo" }
    },
    {
      "@type": "WebSite",
      "@id": "https://jf-aniuta.vercel.app/#website",
      "url": "https://jf-aniuta.vercel.app/",
      "name": "Jean-François & Aniuta - Créations Artisanales",
      "inLanguage": "fr-FR",
      "publisher": { "@id": "https://jf-aniuta.vercel.app/#organization" }
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://jf-aniuta.vercel.app/#localbusiness",
      "name": "Jean-François & Aniuta - Atelier Artisanal (Sculpture & Bougies)",
      "url": "https://jf-aniuta.vercel.app/",
      "priceRange": "€€",
      "image": "https://jf-aniuta.vercel.app/images/logo_512.png",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "149 Route du Pont du Vallat, Chasseradès",
        "addressLocality": "Mont Lozère et Goulet",
        "postalCode": "48250",
        "addressRegion": "Occitanie",
        "addressCountry": "FR"
      },
      "parentOrganization": { "@id": "https://jf-aniuta.vercel.app/#organization" }
    }
  ]
});
---

<MainLayout 
    title="Jean François & ANIUTA Artisans Sculpteurs Lozere 48"
    description="Artisanat du bois et de la bougie. Sculptures sur bois local, bougies champignons, tableaux, cèpes séchés et accessoires à Chasseradès."
    pageId={pageId}>
<script type="application/ld+json" slot="head" set:html={schemaData} />

    <section id="hero">
        <Image 
            src={heroHome} 
            alt="Scènes d'atelier de sculptures et bougies" 
            class="hero-background-image" 
            loading="eager"
            fetchpriority="high"
            quality={80}
            width={1435}
            height={708}
            widths={[480, 600, 800, 1024, 1435]}
            sizes="(max-width: 600px) 480px, (max-width: 1000px) 800px, 1435px"
            decoding="sync"
        />
        <div class="container">
            <h1>L'Héritage Lozérien : Maîtres Sculpteurs et Créateurs d'Artisanat.</h1> 
            <p>Chaleur du bois sculpté, réconfort de la flamme parfumée et objets d'art du quotidien façonnés à la main.</p>
            <a href="/boutique" class="btn large-btn" title="Accéder à notre boutique">Découvrir l'univers</a>
        </div>
    </section>

    <DuelOuverture />

    <section id="accueil">
        <div class="container text-center">
            <div class="section-top-image">
                <Image src={accueilImg} alt="Artisanat Lozère" class="intro-image-1" width={600} height={669} />
            </div>
            
            <h2>L'Art du Bois, de la Matière et des Saveurs.</h2>             
            
            <p>Découvrez l'harmonie entre le bois brut, les matières nobles et le réalisme de nos créations. Notre catalogue s'enrichit de <strong>tableaux originaux</strong>, de <strong>cèpes séchés</strong> pour sublimer votre cuisine, ainsi que d'objets uniques du quotidien : <strong>boîtes de mouchoirs sculptées et miroirs de poche peints à la main</strong>.</p>

            <Image 
                src={tableau3d} 
                alt="Tableau 3D sculpture de champignons sur bois" 
                class="img-collection-elevate"
                width={600} 
                height={800} 
                widths={[480, 600]} 
                sizes="(max-width: 600px) 480px, 600px"
                loading="lazy"
                decoding="async"
            />

            <p>
                Retrouvez également nos incontournables <strong>bougies champignons</strong> en cire 100% naturelle au parfum signature Vanille Gourmande, nos sculptures en bois ("Le Curieux", "Le Majestueux"), ainsi que nos porte-clés hôteliers personnalisables sur demande.
            </p>

            <Image 
                src={imgCollection} 
                alt="Collection de bougies champignons et artisanat de Lozère" 
                class="img-collection-elevate"
                width={800} 
                height={629} 
                widths={[480, 650, 800]} 
                sizes="(max-width: 600px) 480px, (max-width: 800px) 650px, 800px"
                loading="lazy"
                decoding="async"
            />

            <p>
                Chaque pièce est façonnée à la main dans notre atelier à Chasseradès. Profitez de nos services de livraison rapide en <strong>Colissimo ou Mondial Relay</strong> pour la France et l'international.
            </p>

            <a href="/boutique" class="btn">Explorer la Boutique</a> 
        </div>
    </section>

    <section id="atelier">
        <div class="container">
            <div class="section-top-image">
                <Image src={atelierImg} alt="Vue intérieure de l'atelier de création" class="intro-image-2" width={600} height={800} />
            </div>
            <h2>Notre Atelier : Là où la Magie Opère</h2>
            <p>
                Situé à Chasseradès, au cœur de la Lozère, notre atelier rassemble le travail du bois, de la cire et des arts décoratifs. Loin de la fabrication industrielle, nous façonnons des objets authentiques et durables avec la passion du savoir-faire traditionnel.
            </p>
            <a href="/atelier" class="btn">Visiter l'Atelier</a>
        </div>
    </section>

    <section id="apropos">
        <div class="container">
            <div class="section-top-image">
                <Image src={aproposImg} alt="Portrait de l'artisan Jean-François BARON" class="intro-image-3" width={600} height={669} />
            </div>
            <h2>À Propos de l'Artisan et Notre Histoire</h2>
            <p>
                Artisans passionnés, Jean-François & Aniuta se consacrent aux trésors du terroir et à la création artisanale. Des essences locales aux finitions soignées, chaque pièce reflète une démarche exigeante guidée par le plaisir de créer et d'embellir votre quotidien.
            </p>
            <a href="/apropos" class="btn">En Savoir Plus sur Nous</a> 
        </div>
    </section>

</MainLayout>