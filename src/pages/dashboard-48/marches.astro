---
export const prerender = false;
import { kv } from "../../lib/kv";
import AdminHeader from "../../components/AdminHeader.astro";
import '../../styles/admin.css';

interface EventData {
    titre_annonce: string;
    dates: string;
    poster_url?: string;
    horaires: string[];
    description: string;
    map_url: string;
    map_iframe: string;
}

function decodeForInput(str: string | undefined) {
    if (!str) return "";
    const map: Record<string, string> = {
        '&amp;': '&', '&lt;': '<', '&gt;': '>', '&quot;': '"', '&#x27;': "'", '&#x2F;': '/',
    };
    return str.replace(/&amp;|&lt;|&gt;|&quot;|&#x27;|&#x2F;/g, (m: string) => map[m]);
}

const mendeModel = {
    titre_annonce: "Marché Couvert de Mende",
    dates: "Du 23 au 26 Janvier",
    horaires: [
        "Ven. : 08h00 - 13h00",
        "Sam. & Dim. : 09h00 - 19h00",
        "Lun. : 08h00 - 13h00"
    ],
    poster_url: "",
    description: "Retrouvez-nous au cœur du marché couvert de Mende pour découvrir nos dernières sculptures sur bois et nos bougies artisanales.",
    map_url: "https://maps.app.goo.gl/pSesTFPPLNPwGptb7",
    map_iframe: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2844.9865659534867!2d3.4955737760506964!3d44.515428571074295!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12b36de0792c499d%3A0xca92c4b3a1a2ef3e!2sMarch%C3%A9%20Couvert%20De%20Mende!5e0!3m2!1sfr!2sfr!4v1769263957380!5m2!1sfr!2sfr'
};

if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const action = formData.get("action");

        if (action === "update_market") {
            const eventData: EventData = {
                titre_annonce: formData.get("titre_annonce")?.toString() || "",
                dates: formData.get("dates")?.toString() || "",
                horaires: formData.get("horaires")?.toString().split('\n').filter(h => h.trim() !== "") || [],
                description: formData.get("description")?.toString() || "",
                poster_url: formData.get("poster_url")?.toString() || "",
                map_url: formData.get("map_url")?.toString() || "",
                map_iframe: formData.get("map_iframe")?.toString() || ""
            };

            await kv.set('event_status', formData.get("status"));
            await kv.set('event_data', eventData);
        }

        if (action === "archive_market") {
            const currentData: any = await kv.get('event_data');
            const pastMarkets: any[] = await kv.get('past_markets') || [];
            
            if (currentData && currentData.titre_annonce) {
                pastMarkets.unshift(currentData);
                await kv.set('past_markets', pastMarkets);
            }
            
            await kv.set('event_data', mendeModel); 
            await kv.set('event_status', 'attente');
        }

        if (action === "update_archive_item") {
            const index = parseInt(formData.get("index")?.toString() || "-1");
            let pastMarkets: any[] = await kv.get('past_markets') || [];
            if (index >= 0 && index < pastMarkets.length) {
                pastMarkets[index] = {
                    titre_annonce: formData.get("edit_titre")?.toString() || "",
                    dates: formData.get("edit_dates")?.toString() || "",
                    description: formData.get("edit_desc")?.toString() || "",
                    poster_url: formData.get("edit_poster")?.toString() || "",
                };
                await kv.set('past_markets', pastMarkets);
            }
        }

        if (action === "delete_archive_item") {
            const index = parseInt(formData.get("index")?.toString() || "-1");
            let pastMarkets: any[] = await kv.get('past_markets') || [];
            if (index >= 0 && index < pastMarkets.length) {
                pastMarkets.splice(index, 1);
                await kv.set('past_markets', pastMarkets);
            }
        }

        if (action === "delete_history") {
            await kv.del('past_markets');
        }

    } catch (e) {
        console.error("Erreur critique Dashboard:", e);
    }
}

const eventStatus = await kv.get<string>('event_status') || 'attente';
const savedData = await kv.get<EventData>('event_data');

const eventData = {
    titre_annonce: savedData?.titre_annonce || mendeModel.titre_annonce,
    dates: savedData?.dates || mendeModel.dates,
    horaires: savedData?.horaires && savedData.horaires.length > 0 ? savedData.horaires : mendeModel.horaires,
    description: savedData?.description || mendeModel.description,
    poster_url: savedData?.poster_url || mendeModel.poster_url,
    map_url: savedData?.map_url || mendeModel.map_url,
    map_iframe: savedData?.map_iframe || mendeModel.map_iframe
};

const pastMarkets: any[] = await kv.get('past_markets') || [];
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow">
    <title>Gestion Marchés | J.F. & Aniuta</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#fdfaf7">
    <script src="https://upload-widget.cloudinary.com/global/all.js" type="text/javascript"></script>
    <style>
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(45, 34, 26, 0.6);
            backdrop-filter: blur(4px);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal-card {
            background: var(--vanille-pure, #fff);
            padding: 30px;
            border-radius: 8px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border: 1px solid var(--sable-dore);
        }
        .archive-edit-box {
            background: #fff;
            border: 1px solid var(--sable-dore);
            border-radius: 6px;
            padding: 15px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <AdminHeader currentPage="marches" title="Gestion Événements" />

        <div class={`status-banner ${eventStatus === 'actif' ? 'bg-actif' : 'bg-attente'}`}>
            Statut actuel : {eventStatus === 'actif' ? 'Événement en ligne' : 'Mode attente (Cœur affiché)'}
        </div>

        <form id="market-form" method="POST">
            <input type="hidden" name="action" value="update_market" />

            <div class="market-form-grid">
                <div class="form-section">
                    <div class="form-group">
                        <label class="admin-label">Visibilité sur le site</label>
                        <select class="admin-select" name="status">
                            <option value="attente" selected={eventStatus === 'attente'}>Désactivé (Affiche "Bientôt")</option>
                            <option value="actif" selected={eventStatus === 'actif'}>Activé (Affiche les détails)</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label class="admin-label">Titre de l'annonce</label>
                        <input class="admin-input" type="text" name="titre_annonce" value={eventData.titre_annonce} placeholder="Ex: Marché de Mende" required />
                    </div>
                    
                    <div class="form-group">
                        <label class="admin-label">Dates</label>
                        <input class="admin-input" type="text" name="dates" value={eventData.dates} placeholder="Ex: 14 & 15 Janvier" required />
                    </div>
                    
                    <div class="form-group">
                        <label class="admin-label">Horaires (un par ligne)</label>
                        <textarea class="admin-textarea" name="horaires" rows="3">{decodeForInput(eventData.horaires.join('\n'))}</textarea>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-group">
                        <label class="admin-label">Description (Étiquette)</label>
                        <textarea class="admin-textarea" name="description" rows="3">{eventData.description}</textarea>
                    </div>

                    <div class="form-group">
                        <label for="poster_url" class="admin-label">Affiche de l'événement (Prioritaire sur la carte)</label>
                        <input type="text" id="poster_url" name="poster_url" class="admin-input" value={eventData.poster_url} placeholder="URL de l'image de l'affiche">
                        <button type="button" class="btn-upload" onclick="openUploadWidget('poster_url')" style="margin-top: 8px;"><i class="fa-solid fa-cloud-arrow-up"></i> Télécharger via Cloudinary</button>
                    </div>
                    
                    <div class="form-group">
                        <label class="admin-label">Lien Bouton GPS</label>
                        <input class="admin-input" type="text" name="map_url" value={eventData.map_url} placeholder="https://goo.gl/maps/..." />
                    </div>
                    
                    <div class="form-group">
                        <label class="admin-label">Code Carte (Iframe Google Maps - Affiché si pas d'affiche)</label>
                        <textarea class="admin-textarea" name="map_iframe" rows="4" placeholder="Code <iframe src=...">{eventData.map_iframe}</textarea>
                    </div>
                </div>
            </div>
        </form>

        <div class="action-buttons">
            <button type="submit" form="market-form" class="btn btn-add btn-save-market">
                <i class="fa-solid fa-floppy-disk"></i> Enregistrer les modifications
            </button>
            <button type="button" class="btn btn-archive-market" onclick="openModal('archiveModal')">
                <i class="fa-solid fa-box-archive"></i> Archiver et réinitialiser
            </button>
        </div>

        <div class="archive-list" style={pastMarkets.length === 0 ? 'display:none' : ''}>
            <div class="archive-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                <label class="admin-label" style="margin:0">Modifier ou gérer l'historique des marchés</label>
                <button type="button" class="btn-delete-history" onclick="openModal('clearHistoryModal')">Tout effacer</button>
            </div>

            {pastMarkets.map((m, index) => (
                <div class="archive-edit-box">
                    <form method="POST" style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 10px;">
                        <input type="hidden" name="action" value="update_archive_item" />
                        <input type="hidden" name="index" value={index} />
                        
                        <div style="display: flex; gap: 10px;">
                            <input class="admin-input" type="text" name="edit_titre" value={m.titre_annonce} placeholder="Titre" required style="flex:2;" />
                            <input class="admin-input" type="text" name="edit_dates" value={m.dates} placeholder="Dates" required style="flex:1;" />
                        </div>
                        <textarea class="admin-textarea" name="edit_desc" rows="2" placeholder="Description">{m.description}</textarea>
                        <input class="admin-input" type="text" name="edit_poster" value={m.poster_url || ""} placeholder="URL de l'affiche" />

                        <div style="display: flex; justify-content: flex-end;">
                            <button type="submit" class="btn" style="padding: 6px 12px; font-size: 0.8rem; background: var(--brun-coco); color: #fff;">
                                <i class="fa-solid fa-pen"></i> Modifier
                            </button>
                        </div>
                    </form>
                    
                    <form method="POST" style="margin:0; display: flex; justify-content: flex-end;">
                        <input type="hidden" name="action" value="delete_archive_item" />
                        <input type="hidden" name="index" value={index} />
                        <button type="submit" class="btn" style="padding: 6px 12px; font-size: 0.8rem; background: #c0392b; color: #fff;">
                            <i class="fa-solid fa-trash"></i> Supprimer
                        </button>
                    </form>
                </div>
            ))}
        </div>
    </div>

    <div id="archiveModal" class="modal-overlay">
        <div class="modal-card">
            <h3 style="margin-top:0; color:var(--brun-profond);">Archiver l'événement</h3>
            <p style="color:var(--texte-galet); font-size:0.95rem;">Voulez-vous archiver le marché actuel dans les souvenirs et réinitialiser le formulaire ?</p>
            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
                <button type="button" class="btn" onclick="closeModal('archiveModal')" style="background:#ddd; color:#333;">Annuler</button>
                <button type="button" class="btn" onclick="submitAction('archive_market')" style="background:var(--brun-coco); color:#fff;">Confirmer l'archivage</button>
            </div>
        </div>
    </div>

    <div id="clearHistoryModal" class="modal-overlay">
        <div class="modal-card">
            <h3 style="margin-top:0; color:#c0392b;">Supprimer l'historique</h3>
            <p style="color:var(--texte-galet); font-size:0.95rem;">Attention, cette action effacera l'intégralité des souvenirs de marchés enregistrés.</p>
            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
                <button type="button" class="btn" onclick="closeModal('clearHistoryModal')" style="background:#ddd; color:#333;">Annuler</button>
                <button type="button" class="btn" onclick="submitAction('delete_history')" style="background:#c0392b; color:#fff;">Tout effacer</button>
            </div>
        </div>
    </div>

<script is:inline define:vars={{ eventStatus, pastMarkets }}>
    window.eventStatus = eventStatus;
    window.pastMarkets = pastMarkets;
</script>
<script>
    declare global {
        interface Window {
            openUploadWidget: (inputId: string) => void;
            openModal: (modalId: string) => void;
            closeModal: (modalId: string) => void;
            submitAction: (actionName: string) => void;
        }
    }

    const CLOUD_NAME = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "dksok1rxg"; 
    const UPLOAD_PRESET = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || "boutique_preset";

    window.openUploadWidget = (inputId: string) => {
        if (!(window as any).cloudinary) return alert("Le module de téléchargement n'est pas prêt.");
        (window as any).cloudinary.openUploadWidget({
            cloudName: CLOUD_NAME, uploadPreset: UPLOAD_PRESET, sources: ['local', 'url', 'camera'],
            cropping: true, croppingAspectRatio: 700 / 1000,
            transformation: [{ width: 700, crop: "limit" }, { quality: "auto" }, { fetch_format: "auto" }],
            multiple: false, defaultSource: 'local',
        }, (error: any, result: any) => {
            if (!error && result && result.event === "success") {
                const url = (result.info.eager && result.info.eager[0]?.secure_url) ? result.info.eager[0].secure_url : result.info.secure_url;
                const inputEl = document.getElementById(inputId) as HTMLInputElement;
                if (inputEl) inputEl.value = url;
            }
        });
    };

    window.openModal = (modalId: string) => {
        const modal = document.getElementById(modalId);
        if (modal) modal.style.display = 'flex';
    };

    window.closeModal = (modalId: string) => {
        const modal = document.getElementById(modalId);
        if (modal) modal.style.display = 'none';
    };

    window.submitAction = (actionName: string) => {
        const form = document.getElementById('market-form') as HTMLFormElement;
        if (form) {
            const actionInput = form.querySelector('input[name="action"]') as HTMLInputElement;
            if (actionInput) actionInput.value = actionName;
            form.submit();
        }
    };
</script>
</body>
</html>