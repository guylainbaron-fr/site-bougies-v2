---
// src/pages/dashboard-48/cartes.astro
import ThankYouCard from '../../components/ThankYouCard.astro';
import AdminHeader from '../../components/AdminHeader.astro';
import '../../styles/admin.css';
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow">
    <title>Impression Cartes | Atelier</title>
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta name="theme-color" content="#fdfaf7">
    <style is:global>
        .preview-container {
            flex-grow: 1; 
            display: flex;
            justify-content: center; 
            padding: 40px 0;
            overflow-x: auto;
            background: rgba(0, 0, 0, 0.02); /* Fond subtil pour bien détacher la feuille */
        }

        .page-a4 {
            width: 210mm; 
            height: 297mm; 
            background: white; 
            display: flex;
            flex-direction: column;
            /* Remplacement de l'ombre par un cadre propre et élégant */
            border: 1px solid var(--sable-dore, #d3c5b4); 
            box-shadow: none; 
            transform: scale(0.6);
            transform-origin: top center;
            margin-bottom: -100mm; /* Compensation du scale */
            position: relative;
        }

        .half {
          flex: 1;
          display: flex;
          justify-content: center;
          align-items: center;
          position: relative;
          overflow: hidden; /* Empêche les débordements visuels */
      }

      .cut-line {
          position: absolute;
          bottom: 0; left: 0; right: 0;
          border-bottom: 1px dashed #ccc;
          z-index: 10;
      }
      /* Couleur des étoiles — définie directement dans ThankYouCard.astro (#FFD700) */

      /* FOOTER HARMONISÉ */
      .dashboard-footer {
          margin-top: 30px;
          padding: 20px 0;
          border-top: 1px solid var(--sable-dore);
          text-align: center;
      }

      .dashboard-footer p {
          margin: 0;
          font-size: 0.6rem;
          text-transform: uppercase;
          letter-spacing: 2px;
          font-weight: 800;
          color: var(--brun-coco);
          opacity: 0.6;
      }

      /* --- MÉTHODE IMPRESSION --- */
      @media print {
          @page {
            size: A4 portrait;
            margin: 0 !important;
          }

          html, body {
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
          }

          header,
          .admin-header,
          .actions-bar,
          .dashboard-footer,
          footer {
            display: none !important;
          }

          .dashboard-container {
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
            display: block !important;
            border: none !important; /* Supprime la bordure qui crée la 2ème page */
            box-shadow: none !important;
            background: none !important;
          }

          .preview-container {
            padding: 0 !important;
            margin: 0 !important;
            overflow: visible !important;
            display: block !important;
            background: none !important;
          }

          .page-a4 {
            transform: none !important;
            box-shadow: none !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 210mm !important;
            height: 297mm !important;
            position: relative !important;
            top: 0 !important;
            left: 0 !important;
            page-break-after: avoid !important;
            overflow: hidden !important; /* Sécurité anti-débordement */
          }

          .half {
            height: 148.5mm !important;
            flex: none !important;
            width: 100% !important;
            border: none !important;
          }

          .cut-line {
            border-bottom: 1px dashed #eee !important;
          }
      }
    </style>
  </head>
  <body>
    <div class="dashboard-container">
        <AdminHeader currentPage="cartes" title="Impression Cartes" />

        <div class="actions-bar">
            <button class="btn btn-add" onclick="window.print()">
                <i class="fa-solid fa-print"></i> Imprimer les cartes
            </button>
        </div>

        <div class="preview-container">
            <div class="page-a4">
              <div class="half">
                <ThankYouCard />
                <div class="cut-line"></div> 
              </div>
              <div class="half">
                <ThankYouCard />
              </div>
            </div>
        </div>

        <footer class="dashboard-footer">
            <p>&copy; {currentYear} Jean François & Aniuta — Dashboard Atelier</p>
        </footer>
    </div>
  </body>
</html>