---
// src/pages/merci.astro
import MainLayout from '../layouts/MainLayout.astro';
const pageId = "merci";

// Récupération dynamique de l'URL du site depuis le .env
const siteUrl = import.meta.env.SITE || "https://jf-aniuta.vercel.app";

// Schéma JSON-LD dynamique pour la page de remerciement
const schemaData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${siteUrl}/merci#webpage`,
      "url": `${siteUrl}/merci`,
      "name": "Inscription Confirmée - Jean-François & Aniuta",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "description": "Votre inscription à La Note de l'Atelier est bien confirmée. Bienvenue dans l'univers de Jean-François & Aniuta."
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Jean-François & Aniuta",
      "url": `${siteUrl}/`,
      "logo": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        "url": `${siteUrl}/images/logo_512.png`,
        "contentUrl": `${siteUrl}/images/logo_512.png`,
        "width": 512,
        "height": 512
      }
    }
  ]
});
---

<MainLayout 
  title="Inscription Confirmée | Jean François & ANIUTA - Artisans en Lozère"
  description="Merci de votre inscription à la Note de l'Atelier. Votre abonnement est désormais confirmé. Bienvenue dans l'univers de Jean François & Aniuta."
  pageId={pageId}
>
    <meta name="robots" content="noindex, nofollow" slot="head" />
    <script type="application/ld+json" slot="head" set:html={schemaData}></script>

    <section id="contact-page" style="padding: 80px 0; min-height: 50vh; display: flex; align-items: center;">
        <div class="container">
            <div style="max-width: 600px; margin: 0 auto; background: white; padding: 40px; border-radius: 12px; box-shadow: 0 8px 25px rgba(0,0,0,0.05); text-align: center;">
                
                <div class="success-checkmark">
                    <div class="check-icon">
                        <span class="icon-line line-tip"></span>
                        <span class="icon-line line-long"></span>
                    </div>
                </div>
                
                <h2 style="margin-bottom: 20px; color: var(--couleur-texte-sombre);">Inscription confirmée !</h2>
                <p style="margin-bottom: 30px; font-style: italic; color: #5d4037;">
                    "Heureux de partager avec vous nos futurs copeaux de bois et nos parfums de cire."
                </p>
                <p style="margin-bottom: 30px;">
                    Vous recevrez prochainement <strong>La Note de l'Atelier</strong> pour ne rien manquer de nos créations.
                </p>
                <a href="/" class="btn small-btn">Retourner à l'accueil</a>
            </div>
        </div>
    </section>
</MainLayout>